{
  "schema": "quactlize.internal_sweep.model_catalog.v1",
  "description": "Initial real-GGUF model set for the extensible internal tactic/layout sweep. GGUF headers, not this catalog, own tensor qtypes and dimensions.",
  "shape_directory": {
    "dense": "m{m}_n{n}_k{k}_g{group_size}",
    "grouped": "m{m}_n{n}_k{k}_g{group_size}_e{experts}_a{active}_{ragged_profile}"
  },
  "workload_axes": {
    "dense": {
      "decode_m": [1, 2, 4],
      "prefill_m": [64, 2048, 4096]
    },
    "grouped": {
      "decode_tokens": [1, 2, 4],
      "prefill_tokens": [64, 2048, 4096],
      "expert_count_source": "gguf:{architecture}.expert_count",
      "active_expert_source": "gguf:{architecture}.expert_used_count",
      "ragged_profiles": ["balanced-active", "one-heavy"],
      "routing_trace_extension": "optional-versioned-input"
    }
  },
  "tp_policies": {
    "replicated-v1": {
      "default_axis": "replicated",
      "role_partition_axis": {}
    },
    "qwen-tensor-parallel-v1": {
      "default_axis": "replicated",
      "role_partition_axis": {
        "attn_q": "n",
        "attn_k": "n",
        "attn_v": "n",
        "attn_o": "k",
        "ffn_gate": "n",
        "ffn_up": "n",
        "ffn_down": "k",
        "moe_expert_gate": "n",
        "moe_expert_up": "n",
        "moe_expert_down": "k",
        "shared_expert_gate": "n",
        "shared_expert_up": "n",
        "shared_expert_down": "k",
        "moe_router": "replicated",
        "lm_head": "n"
      },
      "expert_axis": "replicated",
      "measurement_scope": "per-rank-local-kernel; inter-rank collectives excluded"
    }
  },
  "models": [
