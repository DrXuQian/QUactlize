// One authority for the bounded Q8_0 overnight performance-envelope reader family.
//
// The including translation unit must define
//   PREFILL_Q8_CANDIDATE(TM, TN, TK, WM, WN, STAGES)
// before including this file. test_scalefirst_bench.cu instantiates the
// shipping collective; L208 instantiates the independent layout oracle over
// the exact same tuples.
//
// This is broader than the original 18-row bring-up table, but is not labeled
// as an exhaustive Cartesian product. It contains:
//   * primary rows over TM={8,16,32,64}, TN={16,32,64,128},
//     TacticTK={32,64,128}, stages={2,3,4};
//   * TN256 capacity controls and TK256 deep-K controls;
//   * alternate WarpN and next-smaller WarpM controls at TK64/s2;
//   * only rows passing atom/divisibility/warp/accumulator/delivery checks
//     and the conservative gs16 scale+zero 256-KiB smem bound.
//
// ArtifactTileK is intentionally absent: every admitted row uses A32/F1 and
// must pass L208 against one canonical artifact, including WON=1/2/4 rows. A
// result may choose a different reader per cell; this file imposes no cross-M
// tactic-sharing policy.
#ifndef PREFILL_Q8_CANDIDATE
#error "define PREFILL_Q8_CANDIDATE before including prefill_q8_candidates.inc"
#endif

#define PREFILL_Q8_EXPECTED_ROWS 172

